APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: leave as "log" (writes to storage/logs/laravel.log, nothing
# real sent). Production uses "gmail-api" (see config/mail.php) — Railway
# blocks outbound SMTP (port 587), confirmed via a real "Connection timed
# out" error, so plain Gmail SMTP never works there. Amazon SES was tried
# next but silently failed too: Gmail blackholes third-party mail that
# claims to be "From" a gmail.com address it didn't actually send (a
# DMARC alignment failure) — confirmed by a real send that reported
# success but never arrived. gmail-api avoids both problems by sending
# genuinely AS the real Gmail account through Gmail's own API.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="tarabasaai.noreply@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Required only when MAIL_MAILER=gmail-api. Reuses the same OAuth client as
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above (an OAuth client isn't
# scope-restricted) — only the refresh token below is new, captured once
# via GET /internal/gmail-authorize (see GmailAuthorizationController).
GMAIL_SEND_REFRESH_TOKEN=

# Amazon SES credentials — kept for reference, not actively used (see the
# gmail-api note above for why SES was ruled out for this specific case:
# sending mail "From" a gmail.com address). Still real infrastructure if
# ever needed for a properly-owned custom domain instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# "Continue with Google" on Login. Leave empty in local dev — the button
# shows a friendly "not set up yet" message until these are filled in.
# From Google Cloud Console > APIs & Services > Credentials > an OAuth
# 2.0 Client ID (Web application). Authorized redirect URI must exactly
# match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
