<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F03_network_model" name="TaraBasa AI: network model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="TaraBasa AI: network model" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="Replaces Figure 42. Everything goes through the Internet over HTTPS; there is no SMS gateway." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="l4" value="Outside services (called by our server only)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="256" y="428" width="480" height="276" as="geometry"/></mxCell><mxCell id="n5" value="Learner" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="30" y="84" width="150" height="46" as="geometry"/></mxCell><mxCell id="n6" value="Teacher" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="210" y="84" width="150" height="46" as="geometry"/></mxCell><mxCell id="n7" value="Parent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#E8F1FB;strokeColor=#