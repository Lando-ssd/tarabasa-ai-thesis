<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F10_teacher_workflow_3" name="Teacher workflow (3 of 4): act"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="914" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Teacher workflow (3 of 4): activities" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="Replaces the activity part of Figure 4.2. The Teacher decides the level; the AI only suggests it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="l4" value="Teacher" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="76" width="314.7826086956522" height="786.0" as="geometry"/></mxCell><mxCell id="l5" value="TaraBasa system and AI services" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="336.7826086956522" y="76" width="409.21739130434787" height="786.0" as="geometry"/></mxCell><mxCell id="n6" value="Activities" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#0B5CAD;strokeColor=#0B5CAD;fontColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="126.3913043478261" y="139.0" width="90" height="26" as="geometry"/></mxCell><mxCell id="n7" value="Ask for activities: grade, skill, kind, how many per level; optionally for a class" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="206.0" width="292.7826086956522" height="56" as="geometry"/></mxCell><mxCell id="n8" value="Check a credit is left; for a class, read its readings and write a short basis" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="347.7826086956522" y="206.0" width="387.21739130434787" height="56" as="geometry"/></mxCell><mxCell id="n9" value="Keep working; a notice shows the progress" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="288.0" width="292.7826086956522" height="56" as="geometry"/></mxCell><mxCell id="n10" value="AI activity writer (Gemini) writes drafts in the background (about 2 minutes)" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="347.7826086956522" y="288.0" width="387.21739130434787" height="56" as="geometry"/></mxCell><mxCell id="n11" value="Review each draft: edit, place in Easy, Medium or Hard, or reject" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="370.0" width="292.7826086956522" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Save the Teacher&#x27;s level next to the AI&#x27;s suggestion; show why" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="347.7826086956522" y="370.0" width="387.21739130434787" height="56" as="geometry"/></mxCell><mxCell id="n13" value="Assign to a learner, class, reading group or focus group" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="452.0" width="292.7826086956522" height="56" as="geometry"/></mxCell><mxCell id="n14" value="Can these children read it? (grade, length)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="401.3913043478261" y="527.0" width="280" height="70" as="geometry"/></mxCell><mxCell id="n15" value="See the reason; choose another activity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="534.0" width="292.7826086956522" height="56" as="geometry"/></mxCell><mxCell id="n16" value="Save the assignment" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="347.7826086956522" y="616.0" width="387.21739130434787" height="56" as="geometry"/></mxCell><mxCell id="n17" value="Share an approved activity to the Open Repository (free or paid)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="698.0" width="292.7826086956522" height="56" as="geometry"/></mxCell><mxCell id="n18" value="List it once; add 2 free credits to the teacher" style="rounded=1;arcSize=12;whiteSpace=wra