<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F02_architecture_tech_stack" name="TaraBasa AI: system architectu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="TaraBasa AI: system architecture and technology stack" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="Replaces the Technology Stack Diagram (Table 23) as a picture. No SMS gateway and no Google Speech-to-Text." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="l4" value="1. People and their devices" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="74" width="732" height="104" as="geometry"/></mxCell><mxCell id="l5" value="2. What people open" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="198" width="732" height="112" as="geometry"/></mxCell><mxCell id="l6" value="3. Application server (Render, Singapore, Docker image, PHP 8.4)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="332" width="732" height="112" as="geometry"/></mxCell><mxCell id="l7" value="4. Data" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#F3F5F8;strokeColor=#B8C0CC;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="476" width="360" height="124" as="geometry"/></mxCell><mxCell id="l8" value="5. Outside services (HTTPS)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=right;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="388" y="476" width="358" height="368" as="geometry"/></mxCell><mxCell id="n9" value="Learner&lt;br&gt;Android phone or tablet, or a browser" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="26" y="112" width="168" height="56" as="geometry"/></mxCell><mxCell id="n10" value="Teacher&lt;br&gt;Android phone, or a laptop browser" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="206" y="112" width="168" height="56" as="geometry"/></mxCell><mxCell id="n11" value="Parent&lt;br&gt;Android phone, or a browser" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="386" y="112" width="168" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Admin&lt;br&gt;Laptop browser (website only)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="566" y="112" width="168" height="56" as="geometry"/></mxCell><mxCell id="n13" value="Phone app (version 0.5.4)&lt;br&gt;React Native with Expo SDK 57, React 19, TypeScript&lt;br&gt;Android 7 or newer; scans QR cards; records audio" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="30" y="234" width="340" height="66" as="geometry"/></mxCell><mxCell id="n14" value="Website&lt;br&gt;Laravel Blade pages with plain JavaScript&lt;br&gt;Chrome, Edge or Firefox; all four roles" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="390" y="234" width="340" height="66" as="geometry"/></mxCell><mxCell id="n15" value="Laravel 13&lt;br&gt;web pages and forms&lt;br&gt;session sign in" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="28" y="368" width="168" height="66" as="geometry"/></mxCell><mxCell id="n16" value="JSON API for the phone&lt;br&gt;Sanctum tokens&lt;br&gt;token fence by role" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="208" y="368" width="168" height="66" as="geometry"/></mxCell><mxCell id="n17" value="Rule engine (services)&lt;br&gt;progression, patterns,&lt;br&gt;fit, alerts, word bank" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="388" y="368" width="168" height="66" as="geometry"/></mxCell><mxCell id="n18" value="Background worker&lt;br&gt;queue in the database&lt;br&gt;writes AI drafts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="568" y="368" width="166" height="66" as="geometry"/></mxCell><mxCell id="n19" value="TiDB Cloud Starter&lt;br&gt;MySQL compatible&lt;br&gt;AWS Singapore" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#F3F5F8;strokeColor=#44546A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="36" y="514" width="160" height="76" as="geometry"/></mxCell><mxCell id="n20" value="SQLite&lt;br&gt;only on a developer&#x27;s&lt;br&gt;computer" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#F3F5F8;strokeColor=#44546A;fontColor=#1F2937;strokeWidth=1.6;dashed=1;" vertex="1" parent="1"><mxGeometry x="212" y="514" width="150" height="76" as="geometry"/></mxCell><mxCell id="n21" value="Reading service (Vosk)&lt;br&gt;Reading-api v3, FastAPI on Render&lt;br&gt;scores a recording" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="402" y="514" width="330" height="64" as="geometry"/></mxCell><mxCell id="n22" value="Activity writer&lt;br&gt;Gemini through a FastAPI service&lt;br&gt;writes draft activities" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="402" y="590" width="330" height="64" as="geometry"/></mxCell><mxCell id="n23" value="Adaptive recommender&lt;br&gt;formulas only, FastAPI on Render&lt;br&gt;updates the profile, suggests next" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="402" y="666" width="330" height="64" as="geometry"/></mxCell><mxCell id="n24" value="Gmail API (OAuth)&lt;br&gt;sends confirmation and reset emails" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="402" y="742" width="330" height="64" as="geometry"/></mxCell><mxCell id="n25" value="Safety: HTTPS, security headers, rate limits, role checks on every route, PINs and passwords hashed, nothing sensitive in the address, no card numbers stored." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#F3F5F8;strokeColor=#B8C0CC;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="616" width="354" height="106" as="geometry"/></mxCell><mxCell id="n26" value="Free hosting limits: the server and the three AI services sleep when idle (about a minute to wake). The page wakes them from the browser; the server waits for them." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="736" width="354" height="108" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110.0" y="201.0"/><mxPoint x="200.0" y="201.0"/></Array></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290.0" y="201.0"/><mxPoint x="200.0" y="201.0"/></Array></mxGeometry></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470.0" y="201.0"/><mxPoint x="200.0" y="201.0"/></Array></mxGeometry></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650.0" y="201.0"/><mxPoint x="560.0" y="201.0"/></Array></mxGeometry></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="268.0" y="334.0"/><mxPoint x="292.0" y="334.0"/></Array></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#44546A;strokeWidt