<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F05_learner_workflow_1" name="Learner workflow (1 of 3): sig"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1085" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Learner workflow (1 of 3): sign in and first reading check" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="Replaces Figure 3.1. The first check starts where the Parent&#x27;s profile says the child is." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="l4" value="Learner" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="76" width="321.77777777777777" height="957.0" as="geometry"/></mxCell><mxCell id="l5" value="TaraBasa system" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="343.77777777777777" y="76" width="402.22222222222223" height="957.0" as="geometry"/></mxCell><mxCell id="n6" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#0B5CAD;strokeColor=#0B5CAD;fontColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="139.88888888888889" y="140.0" width="70" height="26" as="geometry"/></mxCell><mxCell id="n7" value="Scan the learner card, or type the Learner Code" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="209.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n8" value="Enter the 4 digit PIN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="293.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n9" value="Code and PIN correct?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="419.8888888888889" y="377.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="n10" value="See a short message. After 5 wrong tries wait 15 minutes; the parent is told" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="377.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n11" value="First reading check done?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="414.8888888888889" y="461.0" width="260" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Hear the welcome; one word microphone warm-up" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="461.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n13" value="Start at the step the Parent&#x27;s profile suggests (letters up to stories)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="545.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n14" value="Read the item aloud and record" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="629.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n15" value="Reading service (Vosk) scores the recording" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="629.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n16" value="Score 90 or more, below 70, or between?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="419.8888888888889" y="704.0" width="250" height="74" as="geometry"/></mxCell><mxCell id="n17" value="Go up one rung, down one rung, or stop here (at most 3 items)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="797.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n18" value="See a friendly result: no score, only a reading step" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="881.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n19" value="Save the step and level; start the adaptive profile" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="881.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n20" value="Dashboard" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#0B5CAD;strokeColor=#0B5CAD;fontColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="489.8888888888889" y="979.0" width="110" height="28" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="544.9" y="321.0"/></Array></mxGeometry></mxCell><mxCell id="e