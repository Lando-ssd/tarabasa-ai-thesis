<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F15_adaptive_rule_chain" name="Adaptive reading support: from"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1018" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Adaptive reading support: from a recording to a decision" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="New figure. Every step is a written rule or a formula; there is no trained model. Numbers are the team&#x27;s own settings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="n4" value="Recording from the phone or browser" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="330" height="64" as="geometry"/></mxCell><mxCell id="n5" value="Audio file, up to 15 MB. A try shorter than 1 second or too quiet is not sent." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5B6675;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="78" width="372" height="64" as="geometry"/></mxCell><mxCell id="n6" value="Reading service (Vosk) scores it" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="330" height="64" as="geometry"/></mxCell><mxCell id="n7" value="Words heard with time and confidence, accuracy by word comparison, words a minute, voice score. The teammate&#x27;s service." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5B6675;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="172" width="372" height="64" as="geometry"/></mxCell><mxCell id="n8" value="Accept same sound words" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="264" width="330" height="64" as="geometry"/></mxCell><mxCell id="n9" value="sun and son, mangoes and mangos, 2 and two, sand + castle. Near misses (hit and hat) stay mistakes." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5B6675;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="266" width="372" height="64" as="geometry"/></mxCell><mxCell id="n10" value="Leave faint words &#x27;not sure&#x27;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="358" width="330" height="64" as="geometry"/></mxCell><mxCell id="n11" value="Heard below 0.50 confidence and not matching: left out of the score and the word bank. At most 25 percent of the words." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5B6675;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="360" width="372" height="64" as="geometry"/></mxCell><mxCell id="n12" value="Save the reading and word by word feedback" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="452" width="330" height="64" as="geometry"/></mxCell><mxCell id="n13" value="Correct, skipped, a different word, mispronounced, said twice. Missed words go to the word bank." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5B6675;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="454" width="372" height="64" as="geometry"/></mxCell><mxCell id="n14" value="Move the reading step?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="546" width="330" height="64" as="geometry"/></mxCell><mxCell id="n15" value="Up one step: 3 strong readings (90 percent or more, enough words) of at least 2 activities. Down one: 2 weak readings (under 70) in a row. Only readings after the last move count." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5B6675;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="548" width="372" height="64" as="geometry"/></mxCell><mxCell id="n16" value="Adaptive recommender updates the profile" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="330" height="64" as="geometry"/></mxCell><mxCell id="n17" value="Proficiency (moving average, 0.30), confidence (+0.08 per reading); picks the next competency and level." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5B6675;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="642" width="372" height="64" as="geometry"/></mxCell><mxCell id="n18" value="Find the main mistake pattern" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="734" width="330" height="64" as="geometry"/></mxCell><mxCell id="n19" value="Last 8 readings; 10 kinds (endings, vowels, first or last sounds, blends, small words, skipped words, longer words in pieces...). Needs 3 readings and 6 misses." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5B6675;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="736" width="372" height="64" as="geometry"/></mxCell><mxCell id="n20" value="What the decision changes: every screen reads the same result" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="372" y="804" width="372" height="24" as="geometry"/></mxCell><mxCell id="n21" value="Learner&lt;br&gt;Result, points, badges; &#x27;Picked just for you&#x27;; games use missed words first" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="20" y="866" width="174" height="100" as="geometry"/></mxCell><mxCell id="n22" value="Teacher&lt;br&gt;Alerts, analytics, suggested activities, &#x27;Did it work?&#x27;, learner profile" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fontStyle=0;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="204" y="866" width="174" height="100" as="geometry"/></mxCell><mxCell id="n23" value="Parent&lt;br&gt;Plain level, &#x27;Practise at home&#x27;, alerts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize