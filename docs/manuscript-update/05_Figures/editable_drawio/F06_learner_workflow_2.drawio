<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F06_learner_workflow_2" name="Learner workflow (2 of 3): rea"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1443" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Learner workflow (2 of 3): read an activity and get scored" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="Replaces Figures 3.1 and 3.2. A reading step moves slowly: one strong or weak reading does not change it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="l4" value="Learner" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#EEE9FA;strokeColor=#A894DA;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="76" width="308.0851063829787" height="1315.0" as="geometry"/></mxCell><mxCell id="l5" value="TaraBasa system and AI services" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="330.0851063829787" y="76" width="415.9148936170213" height="1315.0" as="geometry"/></mxCell><mxCell id="n6" value="Dashboard" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#0B5CAD;strokeColor=#0B5CAD;fontColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="118.04255319148936" y="137.0" width="100" height="28" as="geometry"/></mxCell><mxCell id="n7" value="Tap Read to see the activities" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="203.0" width="286.0851063829787" height="56" as="geometry"/></mxCell><mxCell id="n8" value="Gather assigned, unlocked and recommended activities; &#x27;Picked just for you&#x27; goes first" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="341.08510638297867" y="203.0" width="393.9148936170213" height="56" as="geometry"/></mxCell><mxCell id="n9" value="Choose an activity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="283.0" width="286.0851063829787" height="56" as="geometry"/></mxCell><mxCell id="n10" value="Listen to Tara read it, then practise (2 free tries)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="363.0" width="286.0851063829787" height="56" as="geometry"/></mxCell><mxCell id="n11" value="Score each try for feedback only; nothing is saved" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="341.08510638297867" y="363.0" width="393.9148936170213" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Read for real and record" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="443.0" width="286.0851063829787" height="56" as="geometry"/></mxCell><mxCell id="n13" value="Audio clear enough?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="418.04255319148933" y="443.0" width="240" height="56" as="geometry"/></mxCell><mxCell id="n14" value="Try again (up to 3 times), then ask the Teacher or Parent" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="341.08510638297867" y="523.0" width="393.9148936170213" height="56" as="geometry"/></mxCell><mxCell id="n15" value="Reading service (Vosk): words, speed, voice" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="341.08510638297867" y="603.0" width="393.9148936170213" height="56" as="geometry"/></mxCell><mxCell id="n16" value="Accept same sound words; leave faint words &#x27;not sure&#x27;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="341.08510638297867" y="683.0" width="393.9148936170213" height="56" as="geometry"/></mxCell><mxCell id="n17" value="Story with questions?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="418.04255319148933" y="763.0" width="240" height="56" as="geometry"/></mxCell><mxCell id="n18" value="Answer the comprehension questions" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;s