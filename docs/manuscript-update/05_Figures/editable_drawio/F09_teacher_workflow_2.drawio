<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F09_teacher_workflow_2" name="Teacher workflow (2 of 4): cla"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1078" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Teacher workflow (2 of 4): classes and learners" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="New. One class holds one grade only, even for a teacher who handles several grades." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="l4" value="Teacher" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="76" width="321.77777777777777" height="950.0" as="geometry"/></mxCell><mxCell id="l5" value="TaraBasa system" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="343.77777777777777" y="76" width="402.22222222222223" height="950.0" as="geometry"/></mxCell><mxCell id="n6" value="Classes" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#0B5CAD;strokeColor=#0B5CAD;fontColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="129.88888888888889" y="139.0" width="90" height="26" as="geometry"/></mxCell><mxCell id="n7" value="Create a class: name, one grade, section, school year" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="206.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n8" value="Grade is one you handle?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="419.8888888888889" y="288.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="n9" value="Ask the Admin to add the grade (see Teacher workflow 1)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="288.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n10" value="Save the class" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="370.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n11" value="Add a learner: type the last 5 characters of the code, or scan the QR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="452.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Check the code as it is typed (check digit); limit wrong tries" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="452.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n13" value="Same grade, reading level fits, not in another class?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="409.8888888888889" y="527.0" width="270" height="70" as="geometry"/></mxCell><mxCell id="n14" value="See the reason; the Add button stays off" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="534.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n15" value="Add the child to the class; tell the parents" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="616.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n16" value="Open the roster: reading groups, tags, learner profile" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="698.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n17" value="Group the class by reading level; show what the parent shared and what suits the child" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="698.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n18" value="Move a learner to another class of the same grade" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="780.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n19" value="Check the same rules again" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="780.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n20" value="Release a learner for promotion; claim a released learner" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="862.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n21" value="Set grade and class from the class that claims" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="862.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n22" value="Past school years stay read only" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="944.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSize=11;fontStyle=1;fontColor=#44546A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#44546A;strokeWidth=1.6;fontSiz