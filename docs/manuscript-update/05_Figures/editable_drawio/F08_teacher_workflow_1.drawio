<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F08_teacher_workflow_1" name="Teacher workflow (1 of 4): acc"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="982" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Teacher workflow (1 of 4): account, approval and grades" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="Replaces Figures 4.1. A Pending teacher can sign in and look, but only an Active teacher touches real students." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="l4" value="Teacher" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#E4F4F1;strokeColor=#79BDB5;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="76" width="321.77777777777777" height="854.0" as="geometry"/></mxCell><mxCell id="l5" value="TaraBasa system and Admin" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="343.77777777777777" y="76" width="402.22222222222223" height="854.0" as="geometry"/></mxCell><mxCell id="n6" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#0B5CAD;strokeColor=#0B5CAD;fontColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="139.88888888888889" y="139.0" width="70" height="26" as="geometry"/></mxCell><mxCell id="n7" value="Sign up: name, school, employee ID, grades, email" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="206.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n8" value="Check the form and the email domain; create account (Pending); send confirmation link" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="206.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n9" value="Open the confirmation link in the email" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="288.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n10" value="Mark the email confirmed (a wrong or old link offers a new one)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="288.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n11" value="Sign in with email and password" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="370.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Sign in allowed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="424.8888888888889" y="452.0" width="240" height="56" as="geometry"/></mxCell><mxCell id="n13" value="See the reason: wrong password, email not confirmed, rejected (with the reason) or deactivated" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="452.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n14" value="Approved by the Admin?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="424.8888888888889" y="534.0" width="240" height="56" as="geometry"/></mxCell><mxCell id="n15" value="Pending: view only, 2 free AI drafts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="534.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n16" value="Active: classes, activities, assigning, sharing" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="616.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n17" value="Dashboard" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#0B5CAD;strokeColor=#0B5CAD;fontColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="124.88888888888889" y="630.0" width="100" height="28" as="geometry"/></mxCell><mxCell id="n18" value="Later: ask to add a grade; say who at school can confirm it" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry 