<mxfile host="app.diagrams.net" agent="TaraBasa AI" version="24.0.0"><diagram id="F12_parent_workflow_1" name="Parent workflow (1 of 2): acco"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1057" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Parent workflow (1 of 2): account and child profile" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="712" height="28" as="geometry"/></mxCell><mxCell id="t3" value="Replaces Figures 5.1 and part of 5.2. A Parent cannot start a child&#x27;s reading: the child signs in with the PIN." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6675;" vertex="1" parent="1"><mxGeometry x="24" y="38" width="712" height="21" as="geometry"/></mxCell><mxCell id="l4" value="Parent" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="14" y="76" width="321.77777777777777" height="929.0" as="geometry"/></mxCell><mxCell id="l5" value="TaraBasa system" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=12;spacingRight=12;fontStyle=1;fontSize=12;spacingTop=6;fillColor=#FFF0DC;strokeColor=#E8A04F;fontColor=#1F2937;opacity=70;" vertex="1" parent="1"><mxGeometry x="343.77777777777777" y="76" width="402.22222222222223" height="929.0" as="geometry"/></mxCell><mxCell id="n6" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#0B5CAD;strokeColor=#0B5CAD;fontColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="139.88888888888889" y="138.0" width="70" height="26" as="geometry"/></mxCell><mxCell id="n7" value="Sign up: name, email, password" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="203.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n8" value="Check the form and email domain; send confirmation link" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="203.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n9" value="Confirm the email, then sign in" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="283.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n10" value="Check the password; limit wrong tries" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="283.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n11" value="Add a child: name, grade, character, reading stage, home language, interests" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="363.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n12" value="Keep the profile; guess the starting step" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="363.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n13" value="Answer 3 questions for the grade; set the 4 digit PIN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="443.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n14" value="Create the learner and Learner Code (with check digit); keep the PIN hashed" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="443.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n15" value="Print or show the learner card with QR code" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="523.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n16" value="Draw the QR here; it holds only the code, never the PIN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="523.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n17" value="Link an existing child: code and the child&#x27;s PIN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="603.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n18" value="Check the PIN; limit wrong tries; tell the other guardians" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="603.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n19" value="Child forgot the PIN: make a new one (password needed)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="683.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n20" value="Apply the rules (max 3 a day); end the child&#x27;s sign ins; tell the other guardians" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="354.7777777777778" y="683.0" width="380.22222222222223" height="56" as="geometry"/></mxCell><mxCell id="n21" value="Remove a child&#x27;s profile (password needed)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="763.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n22" value="Another guardian linked?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#FFF3D6;strokeColor=#E0B04A;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="424.8888888888889" y="843.0" width="240" height="56" as="geometry"/></mxCell><mxCell id="n23" value="Only you are unlinked; the child stays" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontStyle=0;fillColor=#E8F1FB;strokeColor=#7FA8D6;fontColor=#1F2937;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="25.0" y="843.0" width="299.77777777777777" height="56" as="geometry"/></mxCell><mxCell id="n24" value="Delete the child and every record" style="rounded=1;arcSize=12;whiteSpace=w